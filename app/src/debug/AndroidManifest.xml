<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
          Debug only. Exported so adb can reach it; targeted explicitly by component in the verify
          script because implicit manifest broadcasts have been blocked since Android 8.
        -->
        <receiver
            android:name="com.blueberry.debug.TranscriptInjectReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.blueberry.INJECT_TRANSCRIPT" />
            </intent-filter>
        </receiver>

        <!-- Debug only. Runs the on-device model end to end from adb and logs stage timings. -->
        <receiver
            android:name="com.blueberry.debug.LlmProbeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.blueberry.PROBE_LLM" />
            </intent-filter>
        </receiver>

        <!-- Debug only. Speaks a line in a chosen Kokoro voice so they can be auditioned. -->
        <receiver
            android:name="com.blueberry.debug.VoiceProbeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.blueberry.SAY" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
